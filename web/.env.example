NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://repopilot.software — see docs/PRODUCTION_DOMAIN.md
# Show seeded dashboard data without indexing (great for UI design)
NEXT_PUBLIC_DEMO_MODE=true
# Marketing site (separate Vercel project — do not merge)
NEXT_PUBLIC_MARKETING_URL=https://repopilot-pi.vercel.app

# GitHub OAuth App (https://github.com/settings/developers)
# Local callback: http://localhost:3000/api/auth/callback/github
# Production callback: https://repopilot.software/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string for signing session cookies (openssl rand -hex 32)
SESSION_SECRET=

# Shared secret between web BFF and API (openssl rand -hex 32)
INTERNAL_API_SECRET=

# Run indexing inline in API when worker is not running (local dev)
INDEX_INLINE=true
