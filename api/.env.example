# Database
DATABASE_URL=postgresql://rp:secret@localhost:5432/repopilot?schema=public

# Redis / Valkey (Upstash: set REDIS_URL or host+port+password+REDIS_TLS=true)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=rediss://default:password@host.upstash.io:6379
# REDIS_PASSWORD=
# REDIS_TLS=true

# API
PORT=3001
REPO_CLONE_ROOT=/tmp/repopilot-repos

# CORS — comma-separated app origins (marketing site stays separate on Vercel)
# Dev: http://localhost:3000
# Prod app: https://app.repopilot.com
CORS_ORIGINS=http://localhost:3000

# --- AI: pick ONE chat provider (free options below) ---
# LLM_PROVIDER=openai|groq|gemini|ollama|local

# OpenAI (paid; auto-falls back to local embeddings on quota errors)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq — free tier, fast chat (https://console.groq.com)
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Google Gemini — free tier (https://aistudio.google.com/apikey)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# Ollama — fully local, no API key (https://ollama.com)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_CHAT_MODEL=llama3.2
# EMBEDDING_PROVIDER=ollama
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Embeddings: openai | ollama | local (default local-hash if no keys)
# EMBEDDING_PROVIDER=local

# GitHub
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
