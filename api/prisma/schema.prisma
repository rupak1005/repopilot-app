generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---- Phase 2: Repository Analyzer (Repository -> Parsed files -> Symbols/Imports/Exports) ----

model Repository {
  id        String   @id @default(uuid())
  name      String
  owner     String
  createdAt DateTime @default(now())

  files              File[]
  moduleDependencies ModuleDependency[]
}

model File {
  id           String        @id @default(uuid())
  repositoryId String
  repository   Repository    @relation(fields: [repositoryId], references: [id])

  path       String
  content    String
  indexedAt  DateTime       @default(now())

  symbols    Symbol[]
  imports    FileImport[]
  exports    FileExport[]

  @@unique([repositoryId, path])
  @@index([repositoryId])
}

model Symbol {
  id        String   @id @default(uuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  name       String
  type       String
  startLine  Int
  endLine    Int

  outgoingDependencies SymbolDependency[] @relation("SymbolDependencyFrom")
  incomingDependencies SymbolDependency[] @relation("SymbolDependencyTo")

  @@index([fileId])
  @@index([name])
}

model FileImport {
  id         String   @id @default(uuid())
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  module     String
  specifiers String[]

  @@index([fileId])
  @@index([module])
}

model FileExport {
  id      String @id @default(uuid())
  fileId  String
  file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  name String

  @@index([fileId])
  @@index([name])
}

model SymbolDependency {
  id           String @id @default(uuid())
  fromSymbolId String
  toSymbolId   String

  fromSymbol Symbol @relation("SymbolDependencyFrom", fields: [fromSymbolId], references: [id], onDelete: Cascade)
  toSymbol   Symbol @relation("SymbolDependencyTo", fields: [toSymbolId], references: [id], onDelete: Cascade)

  @@unique([fromSymbolId, toSymbolId])
  @@index([fromSymbolId])
  @@index([toSymbolId])
}

model ModuleDependency {
  id           String @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  fromModule   String
  toModule     String

  @@unique([repositoryId, fromModule, toModule])
  @@index([repositoryId])
  @@index([toModule])
}

